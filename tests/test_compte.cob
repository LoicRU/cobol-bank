*> test_compte.cob - tests de COMPTE (fichier indexe, depot, retrait) et de TRX
*> Utilise des fichiers temporaires dans tests/, jamais ceux de data/
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-COMPTE.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT F-TRX ASSIGN TO "tests/TRX_TEST.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS-TRX.

DATA DIVISION.
FILE SECTION.
FD F-TRX.
COPY "TRX.cpy" REPLACING LEADING ==TRX-== BY ==FT-==.

WORKING-STORAGE SECTION.
COPY "COMPTE.cpy".
COPY "TRX.cpy" REPLACING LEADING ==TRX-== BY ==LT-==.
01 WS-ACTION      PIC X.
01 WS-STATUS      PIC XX.
01 WS-ATTENDU     PIC XX.
01 WS-LIBELLE     PIC X(40).
01 WS-NB-ECHECS   PIC 9(3) VALUE 0.
01 WS-SOLDE-AFF   PIC -Z(8)9.99.
01 WS-MONTANT     PIC 9(9)V99 VALUE 0.
01 WS-NUM         PIC 9(10).
01 WS-SKIP        PIC X VALUE "N".
01 WS-FS-TRX      PIC XX.
01 WS-FIN         PIC X.
01 WS-NB-TRX      PIC 9(5).
01 WS-NB-ATT      PIC 9(5).
01 WS-TYPE-ATT    PIC X.
01 WS-STAT-ATT    PIC X.
01 WS-MONT-ATT    PIC 9(9)V99.
01 WS-SOLDE-ATT   PIC S9(9)V99.
01 WS-DST         PIC 9(10) VALUE 0.
01 WS-SOLDE-DST-ATT PIC S9(9)V99.
01 WS-NUM-SAVE    PIC 9(10).
01 WS-SOLDE-SRC-SAVE PIC S9(9)V99.
01 WS-SKIP-DST    PIC X VALUE "N".
01 WS-SOMME       PIC S9(10)V99.
01 WS-SOMME-AV    PIC S9(10)V99.

PROCEDURE DIVISION.
MAIN-PARA.
    CALL "CBL_DELETE_FILE" USING "tests/COMPTES_TEST.dat"
    CALL "CBL_DELETE_FILE" USING "tests/TRX_TEST.dat"
    DISPLAY "COMPTES_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/COMPTES_TEST.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "TRX_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/TRX_TEST.dat" UPON ENVIRONMENT-VALUE

    *> --- fichier indexe : creation, lecture, mise a jour ---
    MOVE 1 TO CPT-NUM
    MOVE 100 TO CPT-ID-CLIENT
    MOVE 100.50 TO CPT-SOLDE
    MOVE 1000.00 TO CPT-PLAFOND
    MOVE "A" TO CPT-STATUT
    MOVE 20261109 TO CPT-DATE-OUV
    MOVE "C" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "00" TO WS-ATTENDU
    MOVE "creer compte 1" TO WS-LIBELLE
    PERFORM VERIFIER

    MOVE 2 TO CPT-NUM
    MOVE 200 TO CPT-ID-CLIENT
    MOVE 50.00 TO CPT-SOLDE
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "creer compte 2" TO WS-LIBELLE
    PERFORM VERIFIER

    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "22" TO WS-ATTENDU
    MOVE "creer doublon (cle existante)" TO WS-LIBELLE
    PERFORM VERIFIER

    MOVE "L" TO WS-ACTION
    MOVE 1 TO WS-NUM
    PERFORM OPERER
    MOVE "00" TO WS-ATTENDU
    MOVE "lire compte 1" TO WS-LIBELLE
    PERFORM VERIFIER
    MOVE CPT-SOLDE TO WS-SOLDE-AFF
    DISPLAY "  solde compte 1 : " WS-SOLDE-AFF
    IF CPT-SOLDE NOT = 100.50
        DISPLAY "FAIL solde attendu 100.50"
        ADD 1 TO WS-NB-ECHECS
    END-IF

    MOVE 999 TO WS-NUM
    PERFORM OPERER
    MOVE "23" TO WS-ATTENDU
    MOVE "lire compte inexistant" TO WS-LIBELLE
    PERFORM VERIFIER

    MOVE 1 TO WS-NUM
    PERFORM OPERER
    MOVE 250.00 TO CPT-SOLDE
    MOVE "U" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "00" TO WS-ATTENDU
    MOVE "mettre a jour solde compte 1" TO WS-LIBELLE
    PERFORM VERIFIER
    MOVE 250.00 TO WS-SOLDE-ATT
    PERFORM RELIRE-SOLDE

    MOVE 999 TO WS-NUM
    INITIALIZE COMPTE-REC
    MOVE WS-NUM TO CPT-NUM
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "23" TO WS-ATTENDU
    MOVE "maj compte inexistant" TO WS-LIBELLE
    PERFORM VERIFIER

    MOVE "X" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "99" TO WS-ATTENDU
    MOVE "action inconnue" TO WS-LIBELLE
    PERFORM VERIFIER

    *> --- depot et retrait (compte 1 : solde de depart 250.00) ---
    MOVE 0 TO WS-NB-ATT

    MOVE "D" TO WS-ACTION
    MOVE 1 TO WS-NUM
    MOVE 100.00 TO WS-MONTANT
    MOVE "00" TO WS-ATTENDU
    MOVE "depot 100.00" TO WS-LIBELLE
    MOVE 350.00 TO WS-SOLDE-ATT
    MOVE "A" TO WS-STAT-ATT
    PERFORM CAS-OP

    MOVE "R" TO WS-ACTION
    MOVE 50.25 TO WS-MONTANT
    MOVE "00" TO WS-ATTENDU
    MOVE "retrait 50.25" TO WS-LIBELLE
    MOVE 299.75 TO WS-SOLDE-ATT
    MOVE "A" TO WS-STAT-ATT
    PERFORM CAS-OP

    MOVE "R" TO WS-ACTION
    MOVE 1000.00 TO WS-MONTANT
    MOVE "93" TO WS-ATTENDU
    MOVE "retrait trop eleve (refus)" TO WS-LIBELLE
    MOVE 299.75 TO WS-SOLDE-ATT
    MOVE "R" TO WS-STAT-ATT
    PERFORM CAS-OP

    MOVE "D" TO WS-ACTION
    MOVE 0 TO WS-MONTANT
    MOVE "91" TO WS-ATTENDU
    MOVE "depot de 0 (refus)" TO WS-LIBELLE
    MOVE 299.75 TO WS-SOLDE-ATT
    MOVE "R" TO WS-STAT-ATT
    PERFORM CAS-OP

    MOVE "D" TO WS-ACTION
    MOVE 999 TO WS-NUM
    MOVE 10.00 TO WS-MONTANT
    MOVE "23" TO WS-ATTENDU
    MOVE "depot compte inexistant (refus)" TO WS-LIBELLE
    MOVE "O" TO WS-SKIP
    MOVE "R" TO WS-STAT-ATT
    PERFORM CAS-OP

    *> compte 2 gele : toute operation refusee
    MOVE "L" TO WS-ACTION
    MOVE 2 TO WS-NUM
    PERFORM OPERER
    MOVE "G" TO CPT-STATUT
    MOVE "U" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "R" TO WS-ACTION
    MOVE 10.00 TO WS-MONTANT
    MOVE "92" TO WS-ATTENDU
    MOVE "retrait sur compte gele (refus)" TO WS-LIBELLE
    MOVE 50.00 TO WS-SOLDE-ATT
    MOVE "R" TO WS-STAT-ATT
    PERFORM CAS-OP

    *> retrait de tout le solde
    MOVE "R" TO WS-ACTION
    MOVE 1 TO WS-NUM
    MOVE 299.75 TO WS-MONTANT
    MOVE "00" TO WS-ATTENDU
    MOVE "retrait de tout le solde" TO WS-LIBELLE
    MOVE 0 TO WS-SOLDE-ATT
    MOVE "A" TO WS-STAT-ATT
    PERFORM CAS-OP

    *> depassement de capacite (compte 3 presque plein)
    INITIALIZE COMPTE-REC
    MOVE 3 TO CPT-NUM
    MOVE 300 TO CPT-ID-CLIENT
    MOVE 999999999.00 TO CPT-SOLDE
    MOVE "A" TO CPT-STATUT
    MOVE "C" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "D" TO WS-ACTION
    MOVE 3 TO WS-NUM
    MOVE 5.00 TO WS-MONTANT
    MOVE "94" TO WS-ATTENDU
    MOVE "depot avec depassement (refus)" TO WS-LIBELLE
    MOVE 999999999.00 TO WS-SOLDE-ATT
    MOVE "R" TO WS-STAT-ATT
    PERFORM CAS-OP

    *> --- virements (comptes 4 : 500.00 et 5 : 100.00, tous deux actifs) ---
    INITIALIZE COMPTE-REC
    MOVE 4 TO CPT-NUM
    MOVE 400 TO CPT-ID-CLIENT
    MOVE 500.00 TO CPT-SOLDE
    MOVE "A" TO CPT-STATUT
    MOVE "C" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE 5 TO CPT-NUM
    MOVE 500 TO CPT-ID-CLIENT
    MOVE 100.00 TO CPT-SOLDE
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS

    MOVE 4 TO WS-NUM
    MOVE 5 TO WS-DST
    MOVE 150.00 TO WS-MONTANT
    MOVE "00" TO WS-ATTENDU
    MOVE "virement 4 vers 5 : 150.00" TO WS-LIBELLE
    MOVE 350.00 TO WS-SOLDE-ATT
    MOVE 250.00 TO WS-SOLDE-DST-ATT
    MOVE "A" TO WS-STAT-ATT
    PERFORM CAS-VIR

    MOVE 1000.00 TO WS-MONTANT
    MOVE "93" TO WS-ATTENDU
    MOVE "virement solde insuffisant (refus)" TO WS-LIBELLE
    MOVE "R" TO WS-STAT-ATT
    PERFORM CAS-VIR

    MOVE 0 TO WS-MONTANT
    MOVE "91" TO WS-ATTENDU
    MOVE "virement de 0 (refus)" TO WS-LIBELLE
    PERFORM CAS-VIR

    MOVE 4 TO WS-DST
    MOVE 10.00 TO WS-MONTANT
    MOVE "95" TO WS-ATTENDU
    MOVE "virement vers le meme compte (refus)" TO WS-LIBELLE
    MOVE 350.00 TO WS-SOLDE-DST-ATT
    PERFORM CAS-VIR

    MOVE 2 TO WS-DST
    MOVE 10.00 TO WS-MONTANT
    MOVE "92" TO WS-ATTENDU
    MOVE "virement vers compte gele (refus)" TO WS-LIBELLE
    MOVE 50.00 TO WS-SOLDE-DST-ATT
    PERFORM CAS-VIR

    MOVE 3 TO WS-DST
    MOVE 5.00 TO WS-MONTANT
    MOVE "94" TO WS-ATTENDU
    MOVE "virement avec depassement (refus)" TO WS-LIBELLE
    MOVE 999999999.00 TO WS-SOLDE-DST-ATT
    PERFORM CAS-VIR

    MOVE 999 TO WS-DST
    MOVE 20.00 TO WS-MONTANT
    MOVE "23" TO WS-ATTENDU
    MOVE "virement vers compte inexistant (refus)" TO WS-LIBELLE
    MOVE "O" TO WS-SKIP-DST
    PERFORM CAS-VIR

    MOVE 2 TO WS-NUM
    MOVE 4 TO WS-DST
    MOVE 10.00 TO WS-MONTANT
    MOVE "92" TO WS-ATTENDU
    MOVE "virement depuis compte gele (refus)" TO WS-LIBELLE
    MOVE 50.00 TO WS-SOLDE-ATT
    MOVE 350.00 TO WS-SOLDE-DST-ATT
    PERFORM CAS-VIR

    MOVE 998 TO WS-NUM
    MOVE 4 TO WS-DST
    MOVE 10.00 TO WS-MONTANT
    MOVE "23" TO WS-ATTENDU
    MOVE "virement depuis compte inexistant (refus)" TO WS-LIBELLE
    MOVE "O" TO WS-SKIP
    PERFORM CAS-VIR

    MOVE 4 TO WS-NUM
    MOVE 5 TO WS-DST
    MOVE 350.00 TO WS-MONTANT
    MOVE "00" TO WS-ATTENDU
    MOVE "virement de tout le solde" TO WS-LIBELLE
    MOVE 0 TO WS-SOLDE-ATT
    MOVE 600.00 TO WS-SOLDE-DST-ATT
    MOVE "A" TO WS-STAT-ATT
    PERFORM CAS-VIR

    CALL "CBL_DELETE_FILE" USING "tests/COMPTES_TEST.dat"
    CALL "CBL_DELETE_FILE" USING "tests/TRX_TEST.dat"
    IF WS-NB-ECHECS = 0
        DISPLAY "TOUS LES TESTS PASSENT"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY WS-NB-ECHECS " TEST(S) EN ECHEC"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

*> Appel de COMPTE sur le compte WS-NUM (enregistrement vide sauf la cle)
OPERER.
    INITIALIZE COMPTE-REC
    MOVE WS-NUM TO CPT-NUM
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS.

*> Cas D/R complet : statut, solde persistant, ligne d'historique
CAS-OP.
    MOVE WS-ACTION TO WS-TYPE-ATT
    MOVE WS-MONTANT TO WS-MONT-ATT
    ADD 1 TO WS-NB-ATT
    PERFORM OPERER
    PERFORM VERIFIER
    IF WS-SKIP NOT = "O"
        PERFORM RELIRE-SOLDE
    END-IF
    PERFORM VERIF-TRX
    MOVE "N" TO WS-SKIP.

*> Cas virement WS-NUM -> WS-DST : statut, deux soldes persistants,
*> somme des deux soldes conservee, ligne d'historique
CAS-VIR.
    MOVE "V" TO WS-TYPE-ATT
    MOVE WS-MONTANT TO WS-MONT-ATT
    ADD 1 TO WS-NB-ATT
    PERFORM LIRE-SOMME
    MOVE WS-SOMME TO WS-SOMME-AV
    MOVE "V" TO WS-ACTION
    MOVE WS-MONT-ATT TO WS-MONTANT
    PERFORM OPERER
    PERFORM VERIFIER
    IF WS-SKIP NOT = "O"
        PERFORM RELIRE-SOLDE
    END-IF
    IF WS-SKIP-DST NOT = "O"
        MOVE WS-NUM TO WS-NUM-SAVE
        MOVE WS-SOLDE-ATT TO WS-SOLDE-SRC-SAVE
        MOVE WS-DST TO WS-NUM
        MOVE WS-SOLDE-DST-ATT TO WS-SOLDE-ATT
        PERFORM RELIRE-SOLDE
        MOVE WS-NUM-SAVE TO WS-NUM
        MOVE WS-SOLDE-SRC-SAVE TO WS-SOLDE-ATT
    END-IF
    PERFORM LIRE-SOMME
    IF WS-SOMME = WS-SOMME-AV
        DISPLAY "  PASS somme des deux soldes conservee"
    ELSE
        DISPLAY "  FAIL somme des soldes : avant " WS-SOMME-AV
                ", apres " WS-SOMME
        ADD 1 TO WS-NB-ECHECS
    END-IF
    PERFORM VERIF-TRX
    MOVE "N" TO WS-SKIP
    MOVE "N" TO WS-SKIP-DST.

*> WS-SOMME = solde du compte WS-NUM + solde du compte WS-DST (0 si absent)
LIRE-SOMME.
    MOVE "L" TO WS-ACTION
    MOVE 0 TO WS-MONTANT
    PERFORM OPERER
    MOVE CPT-SOLDE TO WS-SOMME
    MOVE WS-NUM TO WS-NUM-SAVE
    MOVE WS-DST TO WS-NUM
    PERFORM OPERER
    ADD CPT-SOLDE TO WS-SOMME
    MOVE WS-NUM-SAVE TO WS-NUM.

VERIFIER.
    IF WS-STATUS = WS-ATTENDU
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (statut " WS-STATUS
                ", attendu " WS-ATTENDU ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF.

*> Relit le compte WS-NUM dans le fichier et compare au solde attendu
RELIRE-SOLDE.
    MOVE "L" TO WS-ACTION
    MOVE 0 TO WS-MONTANT
    PERFORM OPERER
    MOVE CPT-SOLDE TO WS-SOLDE-AFF
    IF WS-STATUS = "00" AND CPT-SOLDE = WS-SOLDE-ATT
        DISPLAY "  PASS solde persiste : " WS-SOLDE-AFF
    ELSE
        DISPLAY "  FAIL solde lu : " WS-SOLDE-AFF
        ADD 1 TO WS-NB-ECHECS
    END-IF.

*> Compte les lignes de l'historique et controle la derniere
VERIF-TRX.
    MOVE 0 TO WS-NB-TRX
    MOVE "N" TO WS-FIN
    OPEN INPUT F-TRX
    IF WS-FS-TRX = "00"
        PERFORM UNTIL WS-FIN = "O"
            READ F-TRX
                AT END MOVE "O" TO WS-FIN
                NOT AT END
                    ADD 1 TO WS-NB-TRX
                    MOVE FT-REC TO LT-REC
            END-READ
        END-PERFORM
        CLOSE F-TRX
    END-IF
    IF WS-NB-TRX = WS-NB-ATT AND LT-TYPE = WS-TYPE-ATT
       AND LT-STATUT = WS-STAT-ATT AND LT-MONTANT = WS-MONT-ATT
       AND LT-ID = WS-NB-ATT
       AND (WS-TYPE-ATT NOT = "V"
            OR (LT-CPT-SRC = WS-NUM AND LT-CPT-DST = WS-DST))
        DISPLAY "  PASS historique : " WS-NB-TRX " ligne(s), derniere "
                LT-TYPE "/" LT-STATUT
    ELSE
        DISPLAY "  FAIL historique : " WS-NB-TRX " ligne(s), attendu "
                WS-NB-ATT ", derniere " LT-TYPE "/" LT-STATUT
        ADD 1 TO WS-NB-ECHECS
    END-IF.

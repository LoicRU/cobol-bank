    MOVE 0 TO WS-MONTANT WS-DST
    INITIALIZE COMPTE-REC
    MOVE 7000 TO CPT-ID-CLIENT
    MOVE "E" TO CPT-TYPE
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "00" TO WS-ATTENDU
    MOVE "ouverture : compte epargne" TO WS-LIBELLE
    PERFORM VERIFIER
    MOVE CPT-NUM TO WS-NUM-NEW
    IF CPT-NUM > 23 AND CPT-SOLDE = 0 AND CPT-PLAFOND = 0
       AND CPT-DECOUVERT = 0 AND CPT-STATUT = "A" AND CPT-TYPE = "E"
       AND CPT-ID-CLIENT = 7000
        DISPLAY "  PASS compte " CPT-NUM " : solde 0, actif, epargne"
    ELSE
        DISPLAY "  FAIL compte ouvert : " CPT-NUM " " CPT-TYPE
        ADD 1 TO WS-NB-ECHECS
    END-IF
    MOVE WS-NUM-NEW TO WS-NUM
    MOVE 0 TO WS-SOLDE-ATT
    PERFORM RELIRE-SOLDE
    *> la ligne d'historique "O"
    ADD 1 TO WS-NB-ATT
    MOVE "O" TO WS-TYPE-ATT
    MOVE "A" TO WS-STAT-ATT
    MOVE 0 TO WS-MONT-ATT
    PERFORM VERIF-TRX
    *> numeros suivants
    MOVE "N" TO WS-ACTION
    INITIALIZE COMPTE-REC
    MOVE 7000 TO CPT-ID-CLIENT
    MOVE "C" TO CPT-TYPE
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "ouverture : compte courant suivant" TO WS-LIBELLE
    PERFORM VERIFIER
    IF CPT-NUM = WS-NUM-NEW + 1 AND CPT-TYPE = "C"
        DISPLAY "  PASS numero suivant " CPT-NUM
    ELSE
        DISPLAY "  FAIL numero suivant " CPT-NUM
        ADD 1 TO WS-NB-ECHECS
    END-IF
    ADD 1 TO WS-NB-ATT
    PERFORM VERIF-TRX
    *> 3 de plus : 5 comptes au total, puis refus
    PERFORM 3 TIMES
        MOVE "N" TO WS-ACTION
        INITIALIZE COMPTE-REC
        MOVE 7000 TO CPT-ID-CLIENT
        MOVE "C" TO CPT-TYPE
        CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST
                            WS-STATUS
        MOVE "ouverture : comptes 3 a 5 du client" TO WS-LIBELLE
        PERFORM VERIFIER
    END-PERFORM
    INITIALIZE COMPTE-REC
    MOVE 7000 TO CPT-ID-CLIENT
    MOVE "C" TO CPT-TYPE
    MOVE "N" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "88" TO WS-ATTENDU
    MOVE "ouverture : 6e compte refuse (88)" TO WS-LIBELLE
    PERFORM VERIFIER
    INITIALIZE COMPTE-REC
    MOVE 7001 TO CPT-ID-CLIENT
    MOVE "X" TO CPT-TYPE
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "87" TO WS-ATTENDU
    MOVE "ouverture : type invalide (87)" TO WS-LIBELLE
    PERFORM VERIFIER
    INITIALIZE COMPTE-REC
    MOVE 7001 TO CPT-ID-CLIENT
    MOVE "C" TO CPT-TYPE
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "00" TO WS-ATTENDU
    MOVE "ouverture : autre client non limite" TO WS-LIBELLE
    PERFORM VERIFIER.

*> Appel de COMPTE sur le compte WS-NUM (enregistrement vide sauf la cle)
OPERER.
    INITIALIZE COMPTE-REC
    MOVE WS-NUM TO CPT-NUM
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS.

*> Cas D/R complet : statut, solde persistant, ligne d'historique
CAS-OP.
    MOVE WS-ACTION TO WS-TYPE-ATT
    MOVE WS-MONTANT TO WS-MONT-ATT
    ADD 1 TO WS-NB-ATT
    PERFORM OPERER
    PERFORM VERIFIER
    IF WS-SKIP NOT = "O"
        PERFORM RELIRE-SOLDE
    END-IF
    PERFORM VERIF-TRX
    MOVE "N" TO WS-SKIP.

*> Cas virement WS-NUM -> WS-DST : statut, deux soldes persistants,
*> somme des deux soldes conservee, ligne d'historique
CAS-VIR.
    MOVE "V" TO WS-TYPE-ATT
    MOVE WS-MONTANT TO WS-MONT-ATT
    ADD 1 TO WS-NB-ATT
    PERFORM LIRE-SOMME
    MOVE WS-SOMME TO WS-SOMME-AV
    MOVE "V" TO WS-ACTION
    MOVE WS-MONT-ATT TO WS-MONTANT
    PERFORM OPERER
    PERFORM VERIFIER
    IF WS-SKIP NOT = "O"
        PERFORM RELIRE-SOLDE
    END-IF
    IF WS-SKIP-DST NOT = "O"
        MOVE WS-NUM TO WS-NUM-SAVE
        MOVE WS-SOLDE-ATT TO WS-SOLDE-SRC-SAVE
        MOVE WS-DST TO WS-NUM
        MOVE WS-SOLDE-DST-ATT TO WS-SOLDE-ATT
        PERFORM RELIRE-SOLDE
        MOVE WS-NUM-SAVE TO WS-NUM
        MOVE WS-SOLDE-SRC-SAVE TO WS-SOLDE-ATT
    END-IF
    PERFORM LIRE-SOMME
    IF WS-SOMME = WS-SOMME-AV
        DISPLAY "  PASS somme des deux soldes conservee"
    ELSE
        DISPLAY "  FAIL somme des soldes : avant " WS-SOMME-AV
                ", apres " WS-SOMME
        ADD 1 TO WS-NB-ECHECS
    END-IF
    PERFORM VERIF-TRX
    MOVE "N" TO WS-SKIP
    MOVE "N" TO WS-SKIP-DST.

*> WS-SOMME = solde du compte WS-NUM + solde du compte WS-DST (0 si absent)
LIRE-SOMME.
    MOVE "L" TO WS-ACTION
    MOVE 0 TO WS-MONTANT
    PERFORM OPERER
    MOVE CPT-SOLDE TO WS-SOMME
    MOVE WS-NUM TO WS-NUM-SAVE
    MOVE WS-DST TO WS-NUM
    PERFORM OPERER
    ADD CPT-SOLDE TO WS-SOMME
    MOVE WS-NUM-SAVE TO WS-NUM.

*> Ajoute a la main une sortie acceptee de 900.00 datee de 2020 pour WS-NUM
*> (prend le numero suivant dans l'historique de test)
ECRIRE-TRX-ANCIENNE.
    OPEN EXTEND F-TRX
    IF WS-FS-TRX = "35"
        OPEN OUTPUT F-TRX
    END-IF
    INITIALIZE FT-REC
    ADD 1 TO WS-NB-ATT
    MOVE WS-NB-ATT TO FT-ID
    MOVE 20200101 TO FT-DATE
    MOVE 120000 TO FT-HEURE
    MOVE "R" TO FT-TYPE
    MOVE WS-NUM TO FT-CPT-SRC
    MOVE 900.00 TO FT-MONTANT
    MOVE "A" TO FT-STATUT
    MOVE "SORTIE ANCIENNE (TEST)" TO FT-MOTIF
    WRITE FT-REC
    CLOSE F-TRX.

*> Compte les alertes du journal et controle la derniere :
*> regle, compte (WS-NUM), client, montant (WS-MONT-ATT), numero
VERIF-ALERTES.
    MOVE 0 TO WS-NB-ALR
    MOVE "N" TO WS-FIN
    OPEN INPUT F-ALR
    IF WS-FS-ALR = "00"
        PERFORM UNTIL WS-FIN = "O"
            READ F-ALR
                AT END MOVE "O" TO WS-FIN
                NOT AT END
                    ADD 1 TO WS-NB-ALR
                    MOVE FA-REC TO LA-REC
            END-READ
        END-PERFORM
        CLOSE F-ALR
    END-IF
    IF WS-NB-ALR = WS-NB-ALR-ATT AND LA-REGLE = WS-REGLE-ATT
       AND LA-CPT = WS-NUM AND LA-ID-CLIENT = WS-CLI-ATT
       AND LA-MONTANT = WS-MONT-ATT AND LA-ID = WS-NB-ALR-ATT
        DISPLAY "  PASS journal : " WS-NB-ALR " alerte(s), derniere "
                LA-REGLE
    ELSE
        DISPLAY "  FAIL journal : " WS-NB-ALR " alerte(s), attendu "
                WS-NB-ALR-ATT ", derniere " LA-REGLE
        ADD 1 TO WS-NB-ECHECS
    END-IF.

VERIFIER.
    IF WS-STATUS = WS-ATTENDU
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (statut " WS-STATUS
                ", attendu " WS-ATTENDU ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF.

*> Relit le compte WS-NUM dans le fichier et compare au solde attendu
RELIRE-SOLDE.
    MOVE "L" TO WS-ACTION
    MOVE 0 TO WS-MONTANT
    PERFORM OPERER
    MOVE CPT-SOLDE TO WS-SOLDE-AFF
    IF WS-STATUS = "00" AND CPT-SOLDE = WS-SOLDE-ATT
        DISPLAY "  PASS solde persiste : " WS-SOLDE-AFF
    ELSE
        DISPLAY "  FAIL solde lu : " WS-SOLDE-AFF
        ADD 1 TO WS-NB-ECHECS
    END-IF.

*> Compte les lignes de l'historique et controle la derniere
VERIF-TRX.
    MOVE 0 TO WS-NB-TRX
    MOVE "N" TO WS-FIN
    OPEN INPUT F-TRX
    IF WS-FS-TRX = "00"
        PERFORM UNTIL WS-FIN = "O"
            READ F-TRX
                AT END MOVE "O" TO WS-FIN
                NOT AT END
                    ADD 1 TO WS-NB-TRX
                    MOVE FT-REC TO LT-REC
            END-READ
        END-PERFORM
        CLOSE F-TRX
    END-IF
    IF WS-NB-TRX = WS-NB-ATT AND LT-TYPE = WS-TYPE-ATT
       AND LT-STATUT = WS-STAT-ATT AND LT-MONTANT = WS-MONT-ATT
       AND LT-ID = WS-NB-ATT
       AND (WS-TYPE-ATT NOT = "V"
            OR (LT-CPT-SRC = WS-NUM AND LT-CPT-DST = WS-DST))
        DISPLAY "  PASS historique : " WS-NB-TRX " ligne(s), derniere "
                LT-TYPE "/" LT-STATUT
    ELSE
        DISPLAY "  FAIL historique : " WS-NB-TRX " ligne(s), attendu "
                WS-NB-ATT ", derniere " LT-TYPE "/" LT-STATUT
        ADD 1 TO WS-NB-ECHECS
    END-IF.

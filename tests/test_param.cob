*> test_param.cob - tests du fichier de parametres PARAM, puis effet reel
*> d'une valeur modifiee sur AUTH, FRAUDE et BATCH-INT.
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-PARAM.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT F-CFG ASSIGN TO "tests/PARAM_TEST.cfg"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS.

DATA DIVISION.
FILE SECTION.
FD F-CFG.
01 CFG-LIGNE        PIC X(80).

WORKING-STORAGE SECTION.
COPY "PARAMS.cpy".
COPY "CLIENT.cpy".
COPY "COMPTE.cpy".
COPY "BATCH.cpy".
01 WS-FS            PIC XX.
01 WS-STATUS        PIC XX.
01 WS-ATT-STATUS    PIC XX.
01 WS-LIBELLE       PIC X(44).
01 WS-OK            PIC X.
01 WS-NB-ECHECS     PIC 9(3) VALUE 0.
01 WS-NBL           PIC 9.
01 WS-I             PIC 9.
01 WS-LIGNES.
   05 WS-L          PIC X(60) OCCURS 8.
01 WS-ATT-PLAF      PIC 9(7)V99.
01 WS-ATT-FACT      PIC 9(2).
01 WS-ATT-MIN       PIC 9(2).
01 WS-ATT-TAUX      PIC 9V9999.
01 WS-ATT-FRAIS     PIC 9(5)V99.
01 WS-ATT-ECH       PIC 9(2).
01 WS-ATT-ALR       PIC 9(2).
01 WS-ATT-FEN       PIC 9(5).
01 WS-ATT-EPG       PIC 9V9999.
01 WS-ATT-MAXC      PIC 9(2).
01 WS-ATT-MAXI      PIC 9(4).
01 WS-ACTION        PIC X.
01 WS-PIN           PIC X(6).
01 WS-NEW-PIN       PIC X(6).
01 WS-MONTANT       PIC 9(9)V99.
01 WS-DST           PIC 9(10).
01 WS-CPT           PIC 9(10).
01 WS-ID            PIC 9(6).
01 WS-PLAFOND       PIC 9(7)V99.
01 WS-PERIODE       PIC 9(6).
01 WS-AUJ           PIC 9(8).

PROCEDURE DIVISION.
MAIN-PARA.
    DISPLAY "PARAMS_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/PARAM_TEST.cfg" UPON ENVIRONMENT-VALUE
    DISPLAY "CLIENTS_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/PARAM_CLIENTS.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "COMPTES_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/PARAM_COMPTES.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "TRX_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/PARAM_TRX.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "ALERTES_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/PARAM_ALERTES.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "BATCH_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/PARAM_BATCH.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "BATCH_REPORT_DIR" UPON ENVIRONMENT-NAME
    DISPLAY "tests" UPON ENVIRONMENT-VALUE
    PERFORM NETTOYER

    DISPLAY "PARAM : lecture du fichier"
    PERFORM TEST-LECTURE
    DISPLAY "PARAM : fichiers invalides"
    PERFORM TEST-INVALIDES
    DISPLAY "PARAM : effet sur les modules"
    PERFORM TEST-INTEGRATION

    PERFORM NETTOYER
    IF WS-NB-ECHECS = 0
        DISPLAY "TOUS LES TESTS PASSENT"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "ECHECS : " WS-NB-ECHECS
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

NETTOYER.
    CALL "CBL_DELETE_FILE" USING "tests/PARAM_TEST.cfg"
    CALL "CBL_DELETE_FILE" USING "tests/PARAM_CLIENTS.dat"
    CALL "CBL_DELETE_FILE" USING "tests/PARAM_COMPTES.dat"
    CALL "CBL_DELETE_FILE" USING "tests/PARAM_TRX.dat"
    CALL "CBL_DELETE_FILE" USING "tests/PARAM_ALERTES.dat"
    CALL "CBL_DELETE_FILE" USING "tests/PARAM_BATCH.dat"
    CALL "CBL_DELETE_FILE" USING "tests/BATCH_202611.txt".

*> Ecrit les WS-NBL premieres lignes de WS-L dans le fichier de config
ECRIRE-CFG.
    OPEN OUTPUT F-CFG
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-NBL
        MOVE WS-L(WS-I) TO CFG-LIGNE
        WRITE CFG-LIGNE
    END-PERFORM
    CLOSE F-CFG.

*> Appelle PARAM (fichier deja ecrit) et compare statut puis valeurs
CAS-PARAM.
    MOVE "O" TO WS-OK
    CALL "PARAM" USING PARAMS-REC WS-STATUS
    IF WS-STATUS NOT = WS-ATT-STATUS
        MOVE "N" TO WS-OK
    END-IF
    IF WS-ATT-STATUS = "00"
        IF PRM-PLAFOND-DEFAUT NOT = WS-ATT-PLAF
           OR PRM-FACTEUR NOT = WS-ATT-FACT
           OR PRM-MIN-HISTORIQUE NOT = WS-ATT-MIN
           OR PRM-TAUX-ANNUEL NOT = WS-ATT-TAUX
           OR PRM-FRAIS-TENUE NOT = WS-ATT-FRAIS
           OR PRM-MAX-ECHECS NOT = WS-ATT-ECH
           OR PRM-ALERTE-ECHECS NOT = WS-ATT-ALR
           OR PRM-FENETRE-SEC NOT = WS-ATT-FEN
           OR PRM-TAUX-EPARGNE NOT = WS-ATT-EPG
           OR PRM-MAX-COMPTES NOT = WS-ATT-MAXC
           OR PRM-MAX-INSCRIPTIONS NOT = WS-ATT-MAXI
            MOVE "N" TO WS-OK
        END-IF
    END-IF
    IF WS-OK = "O"
        DISPLAY "  PASS " WS-LIBELLE
    ELSE
        DISPLAY "  FAIL " WS-LIBELLE
        DISPLAY "       statut=" WS-STATUS " (attendu " WS-ATT-STATUS ")"
        DISPLAY "       " PRM-PLAFOND-DEFAUT " " PRM-FACTEUR " "
                PRM-MIN-HISTORIQUE " " PRM-TAUX-ANNUEL " "
                PRM-FRAIS-TENUE " " PRM-MAX-ECHECS
        ADD 1 TO WS-NB-ECHECS
    END-IF.

DEFAUTS-ATTENDUS.
    MOVE 1000.00 TO WS-ATT-PLAF
    MOVE 5 TO WS-ATT-FACT
    MOVE 3 TO WS-ATT-MIN
    MOVE 0.0150 TO WS-ATT-TAUX
    MOVE 2.00 TO WS-ATT-FRAIS
    MOVE 3 TO WS-ATT-ECH
    MOVE 2 TO WS-ATT-ALR
    MOVE 300 TO WS-ATT-FEN
    MOVE 0.0300 TO WS-ATT-EPG
    MOVE 5 TO WS-ATT-MAXC
    MOVE 20 TO WS-ATT-MAXI.

TEST-LECTURE.
    MOVE "00" TO WS-ATT-STATUS
    PERFORM DEFAUTS-ATTENDUS
    MOVE "fichier absent : valeurs par defaut" TO WS-LIBELLE
    PERFORM CAS-PARAM

    MOVE 8 TO WS-NBL
    MOVE "ALERTE_ECHECS=4" TO WS-L(7)
    MOVE "FENETRE_ECHECS_SEC=90" TO WS-L(8)
    MOVE "PLAFOND_DEFAUT=250.50" TO WS-L(1)
    MOVE "FACTEUR_ANOMALIE=8" TO WS-L(2)
    MOVE "MIN_HISTORIQUE=4" TO WS-L(3)
    MOVE "TAUX_ANNUEL_PCT=3.25" TO WS-L(4)
    MOVE "FRAIS_TENUE=1.50" TO WS-L(5)
    MOVE "MAX_ECHECS_PIN=2" TO WS-L(6)
    PERFORM ECRIRE-CFG
    MOVE 250.50 TO WS-ATT-PLAF MOVE 8 TO WS-ATT-FACT
    MOVE 4 TO WS-ATT-MIN MOVE 0.0325 TO WS-ATT-TAUX
    MOVE 1.50 TO WS-ATT-FRAIS MOVE 2 TO WS-ATT-ECH
    MOVE 4 TO WS-ATT-ALR MOVE 90 TO WS-ATT-FEN
    MOVE "fichier complet : 8 valeurs lues" TO WS-LIBELLE
    PERFORM CAS-PARAM

    MOVE 5 TO WS-NBL
    MOVE "# commentaire" TO WS-L(1)
    MOVE SPACES TO WS-L(2)
    MOVE "  frais_tenue = 0,75  " TO WS-L(3)
    MOVE "Taux_Annuel_Pct=0" TO WS-L(4)
    MOVE "   # autre commentaire" TO WS-L(5)
    PERFORM ECRIRE-CFG
    PERFORM DEFAUTS-ATTENDUS
    MOVE 0.75 TO WS-ATT-FRAIS MOVE 0 TO WS-ATT-TAUX
    MOVE "commentaires, casse, espaces, virgule" TO WS-LIBELLE
    PERFORM CAS-PARAM

    MOVE 1 TO WS-NBL
    MOVE "MAX_ECHECS_PIN=5" TO WS-L(1)
    PERFORM ECRIRE-CFG
    PERFORM DEFAUTS-ATTENDUS
    MOVE 5 TO WS-ATT-ECH
    MOVE "fichier partiel : le reste par defaut" TO WS-LIBELLE
    PERFORM CAS-PARAM

    MOVE 1 TO WS-NBL
    MOVE "TAUX_EPARGNE_PCT=4,25" TO WS-L(1)
    PERFORM ECRIRE-CFG
    PERFORM DEFAUTS-ATTENDUS
    MOVE 0.0425 TO WS-ATT-EPG
    MOVE "taux epargne 4,25 %" TO WS-LIBELLE
    PERFORM CAS-PARAM

    MOVE 2 TO WS-NBL
    MOVE "MAX_COMPTES_CLIENT=2" TO WS-L(1)
    MOVE "MAX_INSCRIPTIONS_HEURE=500" TO WS-L(2)
    PERFORM ECRIRE-CFG
    PERFORM DEFAUTS-ATTENDUS
    MOVE 2 TO WS-ATT-MAXC
    MOVE 500 TO WS-ATT-MAXI
    MOVE "limites de comptes et d'inscriptions" TO WS-LIBELLE
    PERFORM CAS-PARAM.

*> Une seule ligne invalide par cas
CAS-LIGNE-INVALIDE.
    MOVE 1 TO WS-NBL
    PERFORM ECRIRE-CFG
    PERFORM CAS-PARAM.

TEST-INVALIDES.
    MOVE "61" TO WS-ATT-STATUS
    MOVE "MAX_COMPTES_CLIENT=0" TO WS-L(1)
    MOVE "max comptes = 0 (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "MAX_COMPTES_CLIENT=100" TO WS-L(1)
    MOVE "max comptes = 100 (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "MAX_INSCRIPTIONS_HEURE=0" TO WS-L(1)
    MOVE "max inscriptions = 0 (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "MAX_INSCRIPTIONS_HEURE=10000" TO WS-L(1)
    MOVE "max inscriptions = 10000 (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "MAX_COMPTES_CLIENT=2.5" TO WS-L(1)
    MOVE "max comptes decimal (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "TAUX_EPARGNE_PCT=100.01" TO WS-L(1)
    MOVE "taux epargne > 100 % (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "TAUX_EPARGNE_PCT=-1" TO WS-L(1)
    MOVE "taux epargne negatif (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "TAUX_ANNUEL_PCT=-1" TO WS-L(1)
    MOVE "taux negatif (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "TAUX_ANNUEL_PCT=100.01" TO WS-L(1)
    MOVE "taux > 100 % (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "PLAFOND_DEFAUT=abc" TO WS-L(1)
    MOVE "valeur non numerique (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "PLAFOND_DEFAUT=" TO WS-L(1)
    MOVE "valeur vide (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "PLAFOND_DEFAUT=0" TO WS-L(1)
    MOVE "plafond nul (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "PLAFOND_DEFAUT=10.005" TO WS-L(1)
    MOVE "3 decimales (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "FACTEUR_ANOMALIE=0" TO WS-L(1)
    MOVE "facteur 0 (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "FACTEUR_ANOMALIE=2.5" TO WS-L(1)
    MOVE "facteur non entier (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "MAX_ECHECS_PIN=100" TO WS-L(1)
    MOVE "echecs PIN > 99 (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "ALERTE_ECHECS=1" TO WS-L(1)
    MOVE "alerte echecs < 2 (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "FENETRE_ECHECS_SEC=0" TO WS-L(1)
    MOVE "fenetre nulle (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "FENETRE_ECHECS_SEC=86401" TO WS-L(1)
    MOVE "fenetre > 24 h (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "FRAIS_TENUE=-2" TO WS-L(1)
    MOVE "frais negatifs (61)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "62" TO WS-ATT-STATUS
    MOVE "TAUX_ANNUEL=2" TO WS-L(1)
    MOVE "cle inconnue, faute de frappe (62)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "63" TO WS-ATT-STATUS
    MOVE "FRAIS_TENUE 2.00" TO WS-L(1)
    MOVE "ligne sans signe = (63)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE
    MOVE "FRAIS_TENUE=2=3" TO WS-L(1)
    MOVE "ligne avec deux signes = (63)" TO WS-LIBELLE
    PERFORM CAS-LIGNE-INVALIDE.

CAS-STATUT.
    IF WS-STATUS = WS-ATT-STATUS
        DISPLAY "  PASS " WS-LIBELLE
    ELSE
        DISPLAY "  FAIL " WS-LIBELLE " statut=" WS-STATUS
                " (attendu " WS-ATT-STATUS ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF.

TEST-INTEGRATION.
*> AUTH : 2 echecs de PIN suffisent a bloquer
    MOVE 1 TO WS-NBL
    MOVE "MAX_ECHECS_PIN=2" TO WS-L(1)
    PERFORM ECRIRE-CFG
    INITIALIZE CLIENT-REC
    MOVE 1 TO CLI-ID
    MOVE "TEST" TO CLI-NOM
    MOVE "C" TO CLI-ROLE
    MOVE "1234" TO WS-PIN
    MOVE "C" TO WS-ACTION
    CALL "AUTH" USING WS-ACTION CLIENT-REC WS-PIN WS-NEW-PIN WS-STATUS
    MOVE "L" TO WS-ACTION
    MOVE "0000" TO WS-PIN
    CALL "AUTH" USING WS-ACTION CLIENT-REC WS-PIN WS-NEW-PIN WS-STATUS
    MOVE "81" TO WS-ATT-STATUS
    MOVE "AUTH : 1er echec (81)" TO WS-LIBELLE
    PERFORM CAS-STATUT
    CALL "AUTH" USING WS-ACTION CLIENT-REC WS-PIN WS-NEW-PIN WS-STATUS
    MOVE "82" TO WS-ATT-STATUS
    MOVE "AUTH : 2e echec bloque (MAX_ECHECS_PIN=2)" TO WS-LIBELLE
    PERFORM CAS-STATUT

*> AUTH : configuration invalide -> refus sans toucher au client
    MOVE "MAX_ECHECS_PIN=0" TO WS-L(1)
    PERFORM ECRIRE-CFG
    MOVE "61" TO WS-ATT-STATUS
    CALL "AUTH" USING WS-ACTION CLIENT-REC WS-PIN WS-NEW-PIN WS-STATUS
    MOVE "AUTH : config invalide refusee (61)" TO WS-LIBELLE
    PERFORM CAS-STATUT

*> FRAUDE : plafond par defaut 500.00
    MOVE "PLAFOND_DEFAUT=500.00" TO WS-L(1)
    PERFORM ECRIRE-CFG
    MOVE "C" TO WS-ACTION
    MOVE 1 TO WS-CPT MOVE 1 TO WS-ID MOVE 0 TO WS-PLAFOND
    MOVE 600 TO WS-MONTANT
    CALL "FRAUDE" USING WS-ACTION WS-CPT WS-ID WS-MONTANT WS-PLAFOND
                        WS-STATUS
    MOVE "96" TO WS-ATT-STATUS
    MOVE "FRAUDE : 600 > plafond 500 (96)" TO WS-LIBELLE
    PERFORM CAS-STATUT
    MOVE 400 TO WS-MONTANT
    CALL "FRAUDE" USING WS-ACTION WS-CPT WS-ID WS-MONTANT WS-PLAFOND
                        WS-STATUS
    MOVE "00" TO WS-ATT-STATUS
    MOVE "FRAUDE : 400 <= plafond 500 (00)" TO WS-LIBELLE
    PERFORM CAS-STATUT
    MOVE "PLAFOND_DEFAUT=xyz" TO WS-L(1)
    PERFORM ECRIRE-CFG
    CALL "FRAUDE" USING WS-ACTION WS-CPT WS-ID WS-MONTANT WS-PLAFOND
                        WS-STATUS
    MOVE "61" TO WS-ATT-STATUS
    MOVE "FRAUDE : config invalide refusee (61)" TO WS-LIBELLE
    PERFORM CAS-STATUT

*> BATCH-INT : taux 12 % et frais 5.00 sur 1000.00 -> +10.00 -5.00
    MOVE 2 TO WS-NBL
    MOVE "TAUX_ANNUEL_PCT=12" TO WS-L(1)
    MOVE "FRAIS_TENUE=5.00" TO WS-L(2)
    PERFORM ECRIRE-CFG
    INITIALIZE COMPTE-REC
    MOVE 7 TO CPT-NUM MOVE 1 TO CPT-ID-CLIENT
    MOVE 1000.00 TO CPT-SOLDE MOVE 1000 TO CPT-PLAFOND
    MOVE "A" TO CPT-STATUT MOVE 20260101 TO CPT-DATE-OUV
    MOVE "C" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE 202611 TO WS-PERIODE
    CALL "BATCH-INT" USING WS-PERIODE BATCH-REC WS-STATUS
    MOVE "00" TO WS-ATT-STATUS
    MOVE "BATCH : traitement avec taux 12 %, frais 5.00" TO WS-LIBELLE
    PERFORM CAS-STATUT
    MOVE 7 TO CPT-NUM
    MOVE "L" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    IF CPT-SOLDE = 1005.00 AND BAT-TOT-INTERETS = 10.00
       AND BAT-TOT-FRAIS = 5.00
        DISPLAY "  PASS BATCH : solde 1005.00 (1000 + 10 - 5)"
    ELSE
        DISPLAY "  FAIL BATCH : solde " CPT-SOLDE " interets "
                BAT-TOT-INTERETS " frais " BAT-TOT-FRAIS
        ADD 1 TO WS-NB-ECHECS
    END-IF
    MOVE "TAUX_ANNUEL_PCT=abc" TO WS-L(1)
    MOVE 1 TO WS-NBL
    PERFORM ECRIRE-CFG
    MOVE 202612 TO WS-PERIODE
    CALL "BATCH-INT" USING WS-PERIODE BATCH-REC WS-STATUS
    MOVE "61" TO WS-ATT-STATUS
    MOVE "BATCH : config invalide refusee (61)" TO WS-LIBELLE
    PERFORM CAS-STATUT.

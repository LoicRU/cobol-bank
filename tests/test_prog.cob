*> test_prog.cob - virements programmes (module PROG)
*> Fichiers temporaires dans tests/. La date du jour est passee a PROG, donc
*> le test ne depend pas de l'horloge.
*>   comptes : 1 (500.00), 2 (0), 5 (50.00) au client 100 ; 3 au client 200 ;
*>             4 epargne du client 100 ; 6 et 7 au client 400 ;
*>             8 (100.00) et 9 au client 500
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-PROG.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "COMPTE.cpy".
COPY "PROGRAMME.cpy".
01 WS-ACTION       PIC X.
01 WS-STATUS       PIC XX.
01 WS-LIBELLE      PIC X(52).
01 WS-NB-ECHECS    PIC 9(3) VALUE 0.
01 WS-MONTANT      PIC 9(9)V99 VALUE 0.
01 WS-DST          PIC 9(10) VALUE 0.
01 WS-PACT         PIC X.
01 WS-PSTATUS      PIC XX.
01 WS-DATE         PIC 9(8).
01 WS-NB-OK        PIC 9(5).
01 WS-NB-KO        PIC 9(5).
01 WS-NUM          PIC 9(10).
01 WS-SOLDE-ATT    PIC S9(9)V99.
01 WS-AFF          PIC -(9)9.99.
01 WS-ID-CHERCHE   PIC 9(8).
01 WS-TROUVE       PIC X.
01 WS-NB-LISTE     PIC 9(3).
01 WS-ATT-STATUS   PIC XX.
01 WS-ATT-OK       PIC 9(5).
01 WS-ATT-KO       PIC 9(5).
01 WS-I            PIC 9(3).
01 WS-ID-P1        PIC 9(8).
01 WS-ID-P2        PIC 9(8).
01 WS-ID-P3        PIC 9(8).
01 WS-ID-P4        PIC 9(8).
01 WS-ID-P5        PIC 9(8).
01 WS-ID-P6        PIC 9(8).
01 PROG-COPIE      PIC X(80).

PROCEDURE DIVISION.
MAIN-PARA.
    DISPLAY "PARAMS_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/AUCUN_PARAMS.cfg" UPON ENVIRONMENT-VALUE
    DISPLAY "COMPTES_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/COMPTES_PRG_TEST.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "TRX_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/TRX_PRG_TEST.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "ALERTES_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/ALERTES_PRG_TEST.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "PROGRAMMES_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/PROG_PRG_TEST.dat" UPON ENVIRONMENT-VALUE
    PERFORM NETTOYER

    MOVE 1 TO CPT-NUM  MOVE 100 TO CPT-ID-CLIENT  MOVE 500.00 TO CPT-SOLDE
    MOVE "C" TO CPT-TYPE  PERFORM CREER-COMPTE
    MOVE 2 TO CPT-NUM  MOVE 0 TO CPT-SOLDE  PERFORM CREER-COMPTE
    MOVE 3 TO CPT-NUM  MOVE 200 TO CPT-ID-CLIENT  PERFORM CREER-COMPTE
    MOVE 4 TO CPT-NUM  MOVE 100 TO CPT-ID-CLIENT  MOVE 1000.00 TO CPT-SOLDE
    MOVE "E" TO CPT-TYPE  PERFORM CREER-COMPTE
    MOVE 5 TO CPT-NUM  MOVE 50.00 TO CPT-SOLDE  MOVE "C" TO CPT-TYPE
    PERFORM CREER-COMPTE
    MOVE 6 TO CPT-NUM  MOVE 400 TO CPT-ID-CLIENT  MOVE 500.00 TO CPT-SOLDE
    MOVE "C" TO CPT-TYPE  PERFORM CREER-COMPTE
    MOVE 7 TO CPT-NUM  MOVE 0 TO CPT-SOLDE  PERFORM CREER-COMPTE
    MOVE 8 TO CPT-NUM  MOVE 500 TO CPT-ID-CLIENT  MOVE 100.00 TO CPT-SOLDE
    PERFORM CREER-COMPTE
    MOVE 9 TO CPT-NUM  MOVE 0 TO CPT-SOLDE  PERFORM CREER-COMPTE

    DISPLAY "--- creation : refus"
    MOVE 20270115 TO WS-DATE
    MOVE 1 TO WS-NUM
    PERFORM PREPARER-P1
    MOVE 0 TO PRG-MONTANT
    MOVE "91" TO WS-ATT-STATUS
    MOVE "montant nul (91)" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    PERFORM PREPARER-P1
    MOVE "X" TO PRG-FREQ
    MOVE "53" TO WS-ATT-STATUS
    MOVE "frequence invalide (53)" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    PERFORM PREPARER-P1
    MOVE 20270230 TO PRG-DATE-PROCHAINE
    MOVE "52" TO WS-ATT-STATUS
    MOVE "date inexistante (52)" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    PERFORM PREPARER-P1
    MOVE 20270101 TO PRG-DATE-PROCHAINE
    MOVE "52" TO WS-ATT-STATUS
    MOVE "date passee (52)" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    PERFORM PREPARER-P1
    MOVE 1 TO PRG-CPT-DST
    MOVE "95" TO WS-ATT-STATUS
    MOVE "meme compte (95)" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    PERFORM PREPARER-P1
    MOVE 3 TO PRG-CPT-SRC
    MOVE "74" TO WS-ATT-STATUS
    MOVE "source d'un autre client (74)" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    PERFORM PREPARER-P1
    MOVE 99 TO PRG-CPT-SRC
    MOVE "23" TO WS-ATT-STATUS
    MOVE "source introuvable (23)" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    PERFORM PREPARER-P1
    MOVE 99 TO PRG-CPT-DST
    MOVE "23" TO WS-ATT-STATUS
    MOVE "destination introuvable (23)" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    PERFORM PREPARER-P1
    MOVE 4 TO PRG-CPT-SRC
    MOVE 3 TO PRG-CPT-DST
    MOVE "90" TO WS-ATT-STATUS
    MOVE "epargne vers un autre client (90)" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER

    DISPLAY "--- creation et echeances mensuelles"
    PERFORM PREPARER-P1
    MOVE "00" TO WS-ATT-STATUS
    MOVE "programme mensuel 1 -> 2, 50.00, 1er fevrier" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    MOVE PRG-ID TO WS-ID-P1
    MOVE "epargne vers son courant : accepte" TO WS-LIBELLE
    PERFORM PREPARER-P1
    MOVE 4 TO PRG-CPT-SRC
    MOVE 5.00 TO PRG-MONTANT
    MOVE "U" TO PRG-FREQ
    MOVE "00" TO WS-ATT-STATUS
    PERFORM CREER-ET-VERIFIER
    MOVE PRG-ID TO WS-ID-P6
    MOVE WS-ID-P6 TO PRG-ID
    MOVE 0 TO PRG-ID-CLIENT
    MOVE "A" TO WS-PACT
    MOVE "annulation par l'administrateur" TO WS-LIBELLE
    MOVE "00" TO WS-ATT-STATUS
    PERFORM APPELER-PROG

    MOVE 20270131 TO WS-DATE
    MOVE 0 TO WS-ATT-OK WS-ATT-KO
    MOVE "echeances le 31 janvier : rien" TO WS-LIBELLE
    PERFORM EXECUTER
    MOVE 1 TO WS-NUM MOVE 500.00 TO WS-SOLDE-ATT
    MOVE "solde inchange (500.00)" TO WS-LIBELLE
    PERFORM VERIF-SOLDE

    MOVE 20270201 TO WS-DATE
    MOVE 1 TO WS-ATT-OK  MOVE 0 TO WS-ATT-KO
    MOVE "echeances le 1er fevrier : 1 fait" TO WS-LIBELLE
    PERFORM EXECUTER
    MOVE 1 TO WS-NUM MOVE 450.00 TO WS-SOLDE-ATT
    MOVE "source debitee (450.00)" TO WS-LIBELLE
    PERFORM VERIF-SOLDE
    MOVE 2 TO WS-NUM MOVE 50.00 TO WS-SOLDE-ATT
    MOVE "destination creditee (50.00)" TO WS-LIBELLE
    PERFORM VERIF-SOLDE
    MOVE 0 TO WS-ATT-OK
    MOVE "rejeu le meme jour : aucun doublon" TO WS-LIBELLE
    PERFORM EXECUTER
    MOVE 1 TO WS-NUM MOVE 450.00 TO WS-SOLDE-ATT
    MOVE "solde apres rejeu (450.00)" TO WS-LIBELLE
    PERFORM VERIF-SOLDE

    MOVE 20270501 TO WS-DATE
    MOVE 3 TO WS-ATT-OK
    MOVE "rattrapage : mars, avril et mai" TO WS-LIBELLE
    PERFORM EXECUTER
    MOVE 1 TO WS-NUM MOVE 300.00 TO WS-SOLDE-ATT
    MOVE "source apres rattrapage (300.00)" TO WS-LIBELLE
    PERFORM VERIF-SOLDE
    MOVE WS-ID-P1 TO WS-ID-CHERCHE
    PERFORM CHERCHER-PROGRAMME
    MOVE "prochaine echeance 1er juin, 4 executions" TO WS-LIBELLE
    IF PRG-DATE-PROCHAINE = 20270601 AND PRG-NB-EXEC = 4
       AND PRG-STATUT = "A"
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (" PRG-DATE-PROCHAINE "/"
                PRG-NB-EXEC "/" PRG-STATUT ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF
    MOVE WS-ID-P6 TO WS-ID-CHERCHE
    PERFORM CHERCHER-PROGRAMME
    MOVE "programme annule : jamais execute" TO WS-LIBELLE
    IF PRG-STATUT = "X" AND PRG-NB-EXEC = 0
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE
        ADD 1 TO WS-NB-ECHECS
    END-IF

    DISPLAY "--- unique, fin de mois, refus"
    MOVE 20270502 TO WS-DATE
    PERFORM PREPARER-P1
    MOVE 20.00 TO PRG-MONTANT
    MOVE "U" TO PRG-FREQ
    MOVE 20270601 TO PRG-DATE-PROCHAINE
    MOVE "00" TO WS-ATT-STATUS
    MOVE "programme unique 20.00 le 1er juin" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    MOVE PRG-ID TO WS-ID-P2
    INITIALIZE PROG-REC
    MOVE 500 TO PRG-ID-CLIENT
    MOVE 8 TO PRG-CPT-SRC
    MOVE 9 TO PRG-CPT-DST
    MOVE 1.00 TO PRG-MONTANT
    MOVE 20270531 TO PRG-DATE-PROCHAINE
    MOVE "M" TO PRG-FREQ
    MOVE "00" TO WS-ATT-STATUS
    MOVE "programme mensuel du 31" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    MOVE PRG-ID TO WS-ID-P3

    MOVE 20270601 TO WS-DATE
    MOVE 3 TO WS-ATT-OK
    MOVE "echeances le 1er juin : 3 faits" TO WS-LIBELLE
    PERFORM EXECUTER
    MOVE 1 TO WS-NUM MOVE 230.00 TO WS-SOLDE-ATT
    MOVE "source apres juin (230.00)" TO WS-LIBELLE
    PERFORM VERIF-SOLDE
    MOVE WS-ID-P2 TO WS-ID-CHERCHE
    PERFORM CHERCHER-PROGRAMME
    MOVE "programme unique : termine" TO WS-LIBELLE
    IF PRG-STATUT = "T" AND PRG-NB-EXEC = 1
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (" PRG-STATUT ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF
    MOVE WS-ID-P3 TO WS-ID-CHERCHE
    PERFORM CHERCHER-PROGRAMME
    MOVE "echeance du 31 mai -> 30 juin (mois court)" TO WS-LIBELLE
    IF PRG-DATE-PROCHAINE = 20270630
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (" PRG-DATE-PROCHAINE ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF
    MOVE 20270630 TO WS-DATE
    MOVE 1 TO WS-ATT-OK
    MOVE "echeances le 30 juin : 1 fait" TO WS-LIBELLE
    PERFORM EXECUTER
    MOVE WS-ID-P3 TO WS-ID-CHERCHE
    PERFORM CHERCHER-PROGRAMME
    MOVE "puis 31 juillet (jour d'origine retrouve)" TO WS-LIBELLE
    IF PRG-DATE-PROCHAINE = 20270731
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (" PRG-DATE-PROCHAINE ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF

    PERFORM PREPARER-P1
    MOVE 10000.00 TO PRG-MONTANT
    MOVE "U" TO PRG-FREQ
    MOVE 20270701 TO PRG-DATE-PROCHAINE
    MOVE "00" TO WS-ATT-STATUS
    MOVE "programme unique de 10000.00" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    MOVE PRG-ID TO WS-ID-P4
    PERFORM PREPARER-P1
    MOVE 5.00 TO PRG-MONTANT
    MOVE 5 TO PRG-CPT-DST
    MOVE "U" TO PRG-FREQ
    MOVE 20270801 TO PRG-DATE-PROCHAINE
    MOVE "00" TO WS-ATT-STATUS
    MOVE "programme unique de 5.00 le 1er aout" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    MOVE PRG-ID TO WS-ID-P5
    INITIALIZE COMPTE-REC
    MOVE 5 TO CPT-NUM
    MOVE "L" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    MOVE "C" TO CPT-STATUT
    MOVE "U" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS

    MOVE 20270701 TO WS-DATE
    MOVE 1 TO WS-ATT-OK  MOVE 1 TO WS-ATT-KO
    MOVE "1er juillet : mensuel fait, 10000.00 refuse" TO WS-LIBELLE
    PERFORM EXECUTER
    MOVE WS-ID-P4 TO WS-ID-CHERCHE
    PERFORM CHERCHER-PROGRAMME
    MOVE "refus 93 : reste actif, a reessayer" TO WS-LIBELLE
    IF PRG-STATUT = "A" AND PRG-DERNIER = "93"
       AND PRG-DATE-PROCHAINE = 20270701
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (" PRG-STATUT "/" PRG-DERNIER ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF
    MOVE 20270801 TO WS-DATE
    PERFORM EXECUTER-SANS-COMPTAGE
    MOVE WS-ID-P5 TO WS-ID-CHERCHE
    PERFORM CHERCHER-PROGRAMME
    MOVE "refus definitif (compte clos 92) : statut E" TO WS-LIBELLE
    IF PRG-STATUT = "E" AND PRG-DERNIER = "92"
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (" PRG-STATUT "/" PRG-DERNIER ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF

    DISPLAY "--- annulation, liste, limite"
    PERFORM PREPARER-P1
    MOVE 20270901 TO PRG-DATE-PROCHAINE
    MOVE 4 TO PRG-CPT-SRC
    MOVE 1 TO PRG-CPT-DST
    MOVE "00" TO WS-ATT-STATUS
    MOVE "nouveau programme depuis l'epargne vers 1" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER
    MOVE PRG-ID TO WS-ID-CHERCHE
    MOVE "A" TO WS-PACT
    MOVE WS-ID-CHERCHE TO PRG-ID
    MOVE 999 TO PRG-ID-CLIENT
    MOVE "55" TO WS-ATT-STATUS
    MOVE "annulation par un autre client (55)" TO WS-LIBELLE
    PERFORM APPELER-PROG
    MOVE WS-ID-CHERCHE TO PRG-ID
    MOVE 100 TO PRG-ID-CLIENT
    MOVE "00" TO WS-ATT-STATUS
    MOVE "annulation par le proprietaire" TO WS-LIBELLE
    PERFORM APPELER-PROG
    MOVE WS-ID-CHERCHE TO PRG-ID
    MOVE "56" TO WS-ATT-STATUS
    MOVE "annulation d'un programme deja annule (56)" TO WS-LIBELLE
    PERFORM APPELER-PROG
    MOVE 99999 TO PRG-ID
    MOVE "54" TO WS-ATT-STATUS
    MOVE "annulation d'un programme inconnu (54)" TO WS-LIBELLE
    PERFORM APPELER-PROG

    MOVE 100 TO PRG-ID-CLIENT
    PERFORM COMPTER-LISTE
    MOVE "liste du client 100 : 6 programmes" TO WS-LIBELLE
    IF WS-NB-LISTE = 6
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (" WS-NB-LISTE ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF
    MOVE 0 TO PRG-ID-CLIENT
    PERFORM COMPTER-LISTE
    MOVE "liste complete : 7 programmes" TO WS-LIBELLE
    IF WS-NB-LISTE = 7
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (" WS-NB-LISTE ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF

    MOVE 20270901 TO WS-DATE
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 10
        INITIALIZE PROG-REC
        MOVE 400 TO PRG-ID-CLIENT
        MOVE 6 TO PRG-CPT-SRC
        MOVE 7 TO PRG-CPT-DST
        MOVE 1.00 TO PRG-MONTANT
        MOVE 20271001 TO PRG-DATE-PROCHAINE
        MOVE "M" TO PRG-FREQ
        MOVE "N" TO WS-PACT
        CALL "PROG" USING WS-PACT PROG-REC WS-DATE WS-NB-OK WS-NB-KO
                          WS-PSTATUS
        IF WS-PSTATUS NOT = "00"
            DISPLAY "FAIL creation " WS-I " (" WS-PSTATUS ")"
            ADD 1 TO WS-NB-ECHECS
        END-IF
    END-PERFORM
    PERFORM PREPARER-P1
    MOVE 400 TO PRG-ID-CLIENT
    MOVE 6 TO PRG-CPT-SRC
    MOVE 7 TO PRG-CPT-DST
    MOVE 20271001 TO PRG-DATE-PROCHAINE
    MOVE "51" TO WS-ATT-STATUS
    MOVE "11e programme actif refuse (51)" TO WS-LIBELLE
    PERFORM CREER-ET-VERIFIER

    PERFORM NETTOYER
    IF WS-NB-ECHECS = 0
        DISPLAY "TOUS LES TESTS PASSENT"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY WS-NB-ECHECS " TEST(S) EN ECHEC"
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN.

NETTOYER.
    CALL "CBL_DELETE_FILE" USING "tests/COMPTES_PRG_TEST.dat"
    CALL "CBL_DELETE_FILE" USING "tests/TRX_PRG_TEST.dat"
    CALL "CBL_DELETE_FILE" USING "tests/ALERTES_PRG_TEST.dat"
    CALL "CBL_DELETE_FILE" USING "tests/PROG_PRG_TEST.dat".

CREER-COMPTE.
    MOVE 0 TO CPT-PLAFOND
    MOVE 0 TO CPT-DECOUVERT
    MOVE "A" TO CPT-STATUT
    MOVE "C" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS.

*> Programme de base : mensuel 1 -> 2, 50.00, client 100, 1er fevrier
PREPARER-P1.
    INITIALIZE PROG-REC
    MOVE 100 TO PRG-ID-CLIENT
    MOVE 1 TO PRG-CPT-SRC
    MOVE 2 TO PRG-CPT-DST
    MOVE 50.00 TO PRG-MONTANT
    MOVE 20270201 TO PRG-DATE-PROCHAINE
    MOVE "M" TO PRG-FREQ.

*> Cree PROG-REC puis compare le statut a WS-ATT-STATUS
CREER-ET-VERIFIER.
    MOVE "N" TO WS-PACT
    PERFORM APPELER-PROG.

APPELER-PROG.
    CALL "PROG" USING WS-PACT PROG-REC WS-DATE WS-NB-OK WS-NB-KO
                      WS-PSTATUS
    IF WS-PSTATUS = WS-ATT-STATUS
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (statut " WS-PSTATUS ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF.

*> Echeances a la date WS-DATE ; compare faits / refuses attendus
EXECUTER.
    MOVE "E" TO WS-PACT
    CALL "PROG" USING WS-PACT PROG-REC WS-DATE WS-NB-OK WS-NB-KO
                      WS-PSTATUS
    IF WS-PSTATUS = "00" AND WS-NB-OK = WS-ATT-OK
       AND WS-NB-KO = WS-ATT-KO
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        DISPLAY "FAIL " WS-LIBELLE " (" WS-PSTATUS " " WS-NB-OK "/"
                WS-NB-KO ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF.

EXECUTER-SANS-COMPTAGE.
    MOVE "E" TO WS-PACT
    CALL "PROG" USING WS-PACT PROG-REC WS-DATE WS-NB-OK WS-NB-KO
                      WS-PSTATUS.

*> Cherche le programme WS-ID-CHERCHE (resultat dans PROG-REC)
CHERCHER-PROGRAMME.
    MOVE "N" TO WS-TROUVE
    MOVE 0 TO PRG-ID
    PERFORM UNTIL WS-TROUVE = "O"
        MOVE 0 TO PRG-ID-CLIENT
        MOVE "S" TO WS-PACT
        CALL "PROG" USING WS-PACT PROG-REC WS-DATE WS-NB-OK WS-NB-KO
                          WS-PSTATUS
        IF WS-PSTATUS NOT = "00"
            MOVE "O" TO WS-TROUVE
            INITIALIZE PROG-REC
        ELSE
            IF PRG-ID = WS-ID-CHERCHE
                MOVE "O" TO WS-TROUVE
            END-IF
        END-IF
    END-PERFORM.

*> Compte les programmes du client PRG-ID-CLIENT (0 = tous)
COMPTER-LISTE.
    MOVE PRG-ID-CLIENT TO WS-NUM
    MOVE 0 TO WS-NB-LISTE
    MOVE 0 TO PRG-ID
    PERFORM UNTIL WS-PSTATUS = "10"
        MOVE WS-NUM TO PRG-ID-CLIENT
        MOVE "S" TO WS-PACT
        CALL "PROG" USING WS-PACT PROG-REC WS-DATE WS-NB-OK WS-NB-KO
                          WS-PSTATUS
        IF WS-PSTATUS = "00"
            ADD 1 TO WS-NB-LISTE
        END-IF
    END-PERFORM
    MOVE SPACES TO WS-PSTATUS.

VERIF-SOLDE.
    INITIALIZE COMPTE-REC
    MOVE WS-NUM TO CPT-NUM
    MOVE "L" TO WS-ACTION
    CALL "COMPTE" USING WS-ACTION COMPTE-REC WS-MONTANT WS-DST WS-STATUS
    IF WS-STATUS = "00" AND CPT-SOLDE = WS-SOLDE-ATT
        DISPLAY "PASS " WS-LIBELLE
    ELSE
        MOVE CPT-SOLDE TO WS-AFF
        DISPLAY "FAIL " WS-LIBELLE " (solde " WS-AFF ")"
        ADD 1 TO WS-NB-ECHECS
    END-IF.

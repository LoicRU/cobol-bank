*> test_releve.cob - tests des releves de compte RELEVE
*> Historique fabrique a la main (TRX_REL_TEST.dat) puis un test de bout en
*> bout avec de vraies operations COMPTE + BATCH-INT.
*>
*> Compte 1 (client 1, ALICE) :
*>   20261001 D  100 -> 600 | 1005 R 50 -> 550 | 1010 V 1>2 80 -> 470
*>   20261015 V 2>1 30 -> 500 | 1020 F 2 -> 498 | 20261105 I 1.25 -> 499.25
*>   20261107 R 9999 refuse (solde 499.25)
*> Compte 2 (client 2, BOB)  : recoit 80 (180) puis emet 30 (150)
*> Compte 3 (client 3, CLARA): chaine rompue (D 100 -> 600, R 50 -> 500)
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-RELEVE.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT F-CPT ASSIGN TO "tests/COMPTES_REL_TEST.dat"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS RANDOM
        RECORD KEY IS FC-NUM
        FILE STATUS IS WS-FS.
    SELECT F-CLI ASSIGN TO "tests/CLIENTS_REL_TEST.dat"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS RANDOM
        RECORD KEY IS FL-ID
        FILE STATUS IS WS-FS.
    SELECT F-TRX ASSIGN TO "tests/TRX_REL_TEST.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS.
    SELECT F-REL ASSIGN TO DYNAMIC WS-REL-NAME
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS.

DATA DIVISION.
FILE SECTION.
FD F-CPT.
COPY "COMPTE.cpy" REPLACING LEADING ==CPT-== BY ==FC-==
                            ==COMPTE-REC== BY ==FC-REC==.
FD F-CLI.
COPY "CLIENT.cpy" REPLACING LEADING ==CLI-== BY ==FL-==
                            ==CLIENT-REC== BY ==FL-REC==.
FD F-TRX.
COPY "TRX.cpy" REPLACING LEADING ==TRX-== BY ==FT-==
                         ==TRX-REC== BY ==FT-REC==.
FD F-REL.
01 FR-LIGNE        PIC X(100).

WORKING-STORAGE SECTION.
COPY "RELEVE.cpy" REPLACING LEADING ==REL-== BY ==RS-==
                            ==RELEVE-RES== BY ==RS-RES==.
01 WS-FS           PIC XX.
01 WS-REL-NAME     PIC X(100).
01 WS-ID           PIC 9(6).
01 WS-FORMAT       PIC X VALUE "T".
01 WS-CPT          PIC 9(10).
01 WS-DEB          PIC 9(8).
01 WS-FIN-P        PIC 9(8).
01 WS-STATUS       PIC XX.
01 WS-ATT-STATUS   PIC XX.
01 WS-LIBELLE      PIC X(44).
01 WS-ATT-NB       PIC 9(7).
01 WS-ATT-INIT     PIC S9(9)V99.
01 WS-ATT-FIN      PIC S9(9)V99.
01 WS-ATT-DEB      PIC 9(11)V99.
01 WS-ATT-CRED     PIC 9(11)V99.
01 WS-ATT-COH      PIC X.
01 WS-OK           PIC X.
01 WS-NB-ECHECS    PIC 9(3) VALUE 0.
01 WS-FIN          PIC X.
01 WS-TEXTE        PIC X(6000).
01 WS-PTR          PIC 9(5).
01 WS-NB-TROUVE    PIC 9(3).
01 WS-CHERCHE      PIC X(40).
01 WS-LONG         PIC 9(3).
01 WS-ATT-TROUVE   PIC 9(3).
01 WS-MONTANT      PIC 9(9)V99.
01 WS-DST          PIC 9(10).
01 WS-ACTION       PIC X.
01 WS-ID-TRX       PIC 9(10) VALUE 0.
01 WS-AUJ          PIC 9(8).
01 WS-PERIODE      PIC 9(6).
01 WS-T-DATE       PIC 9(8).
01 WS-T-TYPE       PIC X.
01 WS-T-SRC        PIC 9(10).
01 WS-T-DST        PIC 9(10).
01 WS-T-MONT       PIC 9(9)V99.
01 WS-T-STAT       PIC X.
01 WS-T-SS         PIC S9(9)V99.
01 WS-T-SD         PIC S9(9)V99.
COPY "COMPTE.cpy".
COPY "CLIENT.cpy".
COPY "BATCH.cpy" REPLACING LEADING ==BAT-== BY ==RB-==
                           ==BATCH-REC== BY ==RB-REC==.

PROCEDURE DIVISION.
MAIN-PARA.
    DISPLAY "PARAMS_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/AUCUN_PARAMS.cfg" UPON ENVIRONMENT-VALUE
    PERFORM NETTOYER
    PERFORM PREPARER-DONNEES

    DISPLAY "RELEVE : historique fabrique"
    PERFORM TEST-HISTORIQUE-FABRIQUE
    DISPLAY "RELEVE : format CSV"
    PERFORM TEST-CSV
    DISPLAY "RELEVE : cas d'erreur"
    PERFORM TEST-ERREURS
    DISPLAY "RELEVE : bout en bout (COMPTE + BATCH-INT)"
    PERFORM TEST-BOUT-EN-BOUT

    PERFORM NETTOYER
    IF WS-NB-ECHECS = 0
        DISPLAY "TOUS LES TESTS PASSENT"
        MOVE 0 TO RETURN-CODE
        STOP RUN
    ELSE
        DISPLAY "ECHECS : " WS-NB-ECHECS
        MOVE 1 TO RETURN-CODE
        STOP RUN
    END-IF.

NETTOYER.
    CALL "CBL_DELETE_FILE" USING "tests/COMPTES_REL_TEST.dat"
    CALL "CBL_DELETE_FILE" USING "tests/CLIENTS_REL_TEST.dat"
    CALL "CBL_DELETE_FILE" USING "tests/TRX_REL_TEST.dat"
    CALL "CBL_DELETE_FILE" USING "tests/COMPTES_REL_E2E.dat"
    CALL "CBL_DELETE_FILE" USING "tests/TRX_REL_E2E.dat"
    CALL "CBL_DELETE_FILE" USING "tests/BATCH_REL_E2E.dat"
    CALL "CBL_DELETE_FILE" USING "tests/BATCH_REL_E2E.txt"
    CALL "CBL_DELETE_FILE" USING "tests/ALERTES_REL_E2E.dat".


PREPARER-DONNEES.
    DISPLAY "COMPTES_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/COMPTES_REL_TEST.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "CLIENTS_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/CLIENTS_REL_TEST.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "TRX_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/TRX_REL_TEST.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "RELEVE_DIR" UPON ENVIRONMENT-NAME
    DISPLAY "tests" UPON ENVIRONMENT-VALUE

    OPEN OUTPUT F-CLI
    MOVE 1 TO FL-ID MOVE "ALICE" TO FL-NOM
    MOVE "C" TO FL-ROLE MOVE 0 TO FL-SEL FL-PIN-HASH FL-ECHECS
    MOVE "A" TO FL-STATUT
    WRITE FL-REC
    MOVE 2 TO FL-ID MOVE "BOB" TO FL-NOM
    WRITE FL-REC
    MOVE 3 TO FL-ID MOVE "CLARA" TO FL-NOM
    WRITE FL-REC
    CLOSE F-CLI

    OPEN OUTPUT F-CPT
    MOVE 1 TO FC-NUM MOVE 1 TO FC-ID-CLIENT MOVE 499.25 TO FC-SOLDE
    MOVE 1000 TO FC-PLAFOND MOVE "A" TO FC-STATUT
    MOVE 20260101 TO FC-DATE-OUV
    WRITE FC-REC
    MOVE 2 TO FC-NUM MOVE 2 TO FC-ID-CLIENT MOVE 150.00 TO FC-SOLDE
    WRITE FC-REC
    MOVE 3 TO FC-NUM MOVE 3 TO FC-ID-CLIENT MOVE 500.00 TO FC-SOLDE
    WRITE FC-REC
    CLOSE F-CPT

    OPEN OUTPUT F-TRX
    MOVE 20261001 TO WS-T-DATE MOVE "D" TO WS-T-TYPE
    MOVE 0 TO WS-T-SRC MOVE 1 TO WS-T-DST MOVE 100 TO WS-T-MONT
    MOVE "A" TO WS-T-STAT MOVE 0 TO WS-T-SS MOVE 600 TO WS-T-SD
    PERFORM ECRIRE-TRX
    MOVE 20261005 TO WS-T-DATE MOVE "R" TO WS-T-TYPE
    MOVE 1 TO WS-T-SRC MOVE 0 TO WS-T-DST MOVE 50 TO WS-T-MONT
    MOVE 550 TO WS-T-SS MOVE 0 TO WS-T-SD
    PERFORM ECRIRE-TRX
    MOVE 20261010 TO WS-T-DATE MOVE "V" TO WS-T-TYPE
    MOVE 1 TO WS-T-SRC MOVE 2 TO WS-T-DST MOVE 80 TO WS-T-MONT
    MOVE 470 TO WS-T-SS MOVE 180 TO WS-T-SD
    PERFORM ECRIRE-TRX
    MOVE 20261015 TO WS-T-DATE MOVE "V" TO WS-T-TYPE
    MOVE 2 TO WS-T-SRC MOVE 1 TO WS-T-DST MOVE 30 TO WS-T-MONT
    MOVE 150 TO WS-T-SS MOVE 500 TO WS-T-SD
    PERFORM ECRIRE-TRX
    MOVE 20261020 TO WS-T-DATE MOVE "F" TO WS-T-TYPE
    MOVE 1 TO WS-T-SRC MOVE 0 TO WS-T-DST MOVE 2 TO WS-T-MONT
    MOVE 498 TO WS-T-SS MOVE 0 TO WS-T-SD
    PERFORM ECRIRE-TRX
    MOVE 20261105 TO WS-T-DATE MOVE "I" TO WS-T-TYPE
    MOVE 0 TO WS-T-SRC MOVE 1 TO WS-T-DST MOVE 1.25 TO WS-T-MONT
    MOVE 0 TO WS-T-SS MOVE 499.25 TO WS-T-SD
    PERFORM ECRIRE-TRX
    MOVE 20261107 TO WS-T-DATE MOVE "R" TO WS-T-TYPE
    MOVE 1 TO WS-T-SRC MOVE 0 TO WS-T-DST MOVE 9999 TO WS-T-MONT
    MOVE "R" TO WS-T-STAT MOVE 499.25 TO WS-T-SS MOVE 0 TO WS-T-SD
    PERFORM ECRIRE-TRX
    MOVE 20261001 TO WS-T-DATE MOVE "D" TO WS-T-TYPE
    MOVE 0 TO WS-T-SRC MOVE 3 TO WS-T-DST MOVE 100 TO WS-T-MONT
    MOVE "A" TO WS-T-STAT MOVE 0 TO WS-T-SS MOVE 600 TO WS-T-SD
    PERFORM ECRIRE-TRX
    MOVE 20261002 TO WS-T-DATE MOVE "R" TO WS-T-TYPE
    MOVE 3 TO WS-T-SRC MOVE 0 TO WS-T-DST MOVE 50 TO WS-T-MONT
    MOVE 500 TO WS-T-SS MOVE 0 TO WS-T-SD
    PERFORM ECRIRE-TRX
    CLOSE F-TRX.

ECRIRE-TRX.
    ADD 1 TO WS-ID-TRX
    MOVE WS-ID-TRX TO FT-ID
    MOVE WS-T-DATE TO FT-DATE
    MOVE 101500 TO FT-HEURE
    MOVE WS-T-TYPE TO FT-TYPE
    MOVE WS-T-SRC TO FT-CPT-SRC
    MOVE WS-T-DST TO FT-CPT-DST
    MOVE WS-T-MONT TO FT-MONTANT
    MOVE WS-T-STAT TO FT-STATUT
    MOVE SPACES TO FT-MOTIF
    MOVE WS-T-SS TO FT-SOLDE-SRC
    MOVE WS-T-SD TO FT-SOLDE-DST
    WRITE FT-REC
    MOVE "A" TO WS-T-STAT.

*> Appelle RELEVE puis compare statut + resultat avec les valeurs attendues
CAS-RELEVE.
    MOVE "O" TO WS-OK
    CALL "RELEVE" USING WS-ID WS-CPT WS-DEB WS-FIN-P WS-FORMAT
                          RS-RES WS-STATUS
    IF WS-STATUS NOT = WS-ATT-STATUS
        MOVE "N" TO WS-OK
    END-IF
    IF WS-ATT-NB NOT = 9999999
        IF RS-NB-OPS NOT = WS-ATT-NB
           OR RS-SOLDE-INIT NOT = WS-ATT-INIT
           OR RS-SOLDE-FIN NOT = WS-ATT-FIN
           OR RS-TOT-DEBITS NOT = WS-ATT-DEB
           OR RS-TOT-CREDITS NOT = WS-ATT-CRED
           OR RS-COHERENT NOT = WS-ATT-COH
            MOVE "N" TO WS-OK
        END-IF
    END-IF
    PERFORM AFFICHER.

AFFICHER.
    IF WS-OK = "O"
        DISPLAY "  PASS " WS-LIBELLE
    ELSE
        DISPLAY "  FAIL " WS-LIBELLE
        DISPLAY "       statut=" WS-STATUS " (attendu " WS-ATT-STATUS ")"
        DISPLAY "       nb=" RS-NB-OPS " init=" RS-SOLDE-INIT
                " fin=" RS-SOLDE-FIN " deb=" RS-TOT-DEBITS
                " cred=" RS-TOT-CREDITS " coh=" RS-COHERENT
        ADD 1 TO WS-NB-ECHECS
    END-IF.

TEST-HISTORIQUE-FABRIQUE.
    MOVE 1 TO WS-ID MOVE 1 TO WS-CPT
    MOVE "00" TO WS-ATT-STATUS MOVE "O" TO WS-ATT-COH

    MOVE 20261001 TO WS-DEB MOVE 20261031 TO WS-FIN-P
    MOVE 5 TO WS-ATT-NB MOVE 500 TO WS-ATT-INIT MOVE 498 TO WS-ATT-FIN
    MOVE 132 TO WS-ATT-DEB MOVE 130 TO WS-ATT-CRED
    MOVE "compte 1, octobre (5 ops)" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE 20261006 TO WS-DEB
    MOVE 3 TO WS-ATT-NB MOVE 550 TO WS-ATT-INIT
    MOVE 82 TO WS-ATT-DEB MOVE 30 TO WS-ATT-CRED
    MOVE "compte 1, 6 au 31 octobre" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE 20261101 TO WS-DEB MOVE 20261130 TO WS-FIN-P
    MOVE 1 TO WS-ATT-NB MOVE 498 TO WS-ATT-INIT MOVE 499.25 TO WS-ATT-FIN
    MOVE 0 TO WS-ATT-DEB MOVE 1.25 TO WS-ATT-CRED
    MOVE "compte 1, novembre (refus ignore)" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE 20261201 TO WS-DEB MOVE 20261231 TO WS-FIN-P
    MOVE 0 TO WS-ATT-NB MOVE 499.25 TO WS-ATT-INIT
    MOVE 499.25 TO WS-ATT-FIN MOVE 0 TO WS-ATT-DEB WS-ATT-CRED
    MOVE "compte 1, decembre (vide, apres)" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE 20260901 TO WS-DEB MOVE 20260930 TO WS-FIN-P
    MOVE 500 TO WS-ATT-INIT MOVE 500 TO WS-ATT-FIN
    MOVE "compte 1, septembre (vide, avant)" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE 2 TO WS-ID MOVE 2 TO WS-CPT
    MOVE 20261001 TO WS-DEB MOVE 20261031 TO WS-FIN-P
    MOVE 2 TO WS-ATT-NB MOVE 100 TO WS-ATT-INIT MOVE 150 TO WS-ATT-FIN
    MOVE 30 TO WS-ATT-DEB MOVE 80 TO WS-ATT-CRED
    MOVE "compte 2, octobre (virements)" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE 0 TO WS-ID MOVE 1 TO WS-CPT
    MOVE 5 TO WS-ATT-NB MOVE 500 TO WS-ATT-INIT MOVE 498 TO WS-ATT-FIN
    MOVE 132 TO WS-ATT-DEB MOVE 130 TO WS-ATT-CRED
    MOVE "administrateur (client 0)" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE 1 TO WS-ID
    PERFORM CONTROLER-FICHIER.

*> Le fichier du compte 1 (octobre) a ete regenere par le cas administrateur
CONTROLER-FICHIER.
    MOVE "tests/RELEVE_0000000001_20261001_20261031.txt" TO WS-REL-NAME
    PERFORM CHARGER-TEXTE
    MOVE "fichier : titulaire ALICE" TO WS-LIBELLE
    MOVE "Titulaire : ALICE" TO WS-CHERCHE MOVE 17 TO WS-LONG
    MOVE 1 TO WS-ATT-TROUVE
    PERFORM COMPTER
    MOVE "fichier : virement emis" TO WS-LIBELLE
    MOVE "VIREMENT EMIS" TO WS-CHERCHE MOVE 13 TO WS-LONG
    PERFORM COMPTER
    MOVE "fichier : virement recu" TO WS-LIBELLE
    MOVE "VIREMENT RECU" TO WS-CHERCHE MOVE 13 TO WS-LONG
    PERFORM COMPTER
    MOVE "fichier : frais de tenue" TO WS-LIBELLE
    MOVE "FRAIS DE TENUE" TO WS-CHERCHE MOVE 14 TO WS-LONG
    PERFORM COMPTER
    MOVE "fichier : depot et retrait" TO WS-LIBELLE
    MOVE "DEPOT" TO WS-CHERCHE MOVE 5 TO WS-LONG
    PERFORM COMPTER
    MOVE "RETRAIT" TO WS-CHERCHE MOVE 7 TO WS-LONG
    PERFORM COMPTER
    MOVE "fichier : pas d'interets en octobre" TO WS-LIBELLE
    MOVE "INTERETS" TO WS-CHERCHE MOVE 8 TO WS-LONG
    MOVE 0 TO WS-ATT-TROUVE
    PERFORM COMPTER
    MOVE "fichier : verification OK" TO WS-LIBELLE
    MOVE "Verification : OK" TO WS-CHERCHE MOVE 17 TO WS-LONG
    MOVE 1 TO WS-ATT-TROUVE
    PERFORM COMPTER
    MOVE "fichier : solde initial 500.00" TO WS-LIBELLE
    MOVE "Solde initial :        500.00" TO WS-CHERCHE MOVE 28 TO WS-LONG
    PERFORM COMPTER
    MOVE "fichier : solde final 498.00" TO WS-LIBELLE
    MOVE "Solde final :        498.00" TO WS-CHERCHE MOVE 26 TO WS-LONG
    PERFORM COMPTER.

*> Charge le fichier WS-REL-NAME dans WS-TEXTE (lignes concatenees)
CHARGER-TEXTE.
    MOVE SPACES TO WS-TEXTE
    MOVE 1 TO WS-PTR
    MOVE "N" TO WS-FIN
    OPEN INPUT F-REL
    IF WS-FS = "00"
        PERFORM UNTIL WS-FIN = "O"
            READ F-REL
                AT END
                    MOVE "O" TO WS-FIN
                NOT AT END
                    IF WS-PTR < 5800
                        STRING FR-LIGNE DELIMITED BY SIZE
                               INTO WS-TEXTE WITH POINTER WS-PTR
                    END-IF
            END-READ
        END-PERFORM
        CLOSE F-REL
    END-IF.

COMPTER.
    MOVE 0 TO WS-NB-TROUVE
    INSPECT WS-TEXTE TALLYING WS-NB-TROUVE
        FOR ALL WS-CHERCHE(1:WS-LONG)
    MOVE "O" TO WS-OK
    IF WS-ATT-TROUVE = 0
        IF WS-NB-TROUVE NOT = 0
            MOVE "N" TO WS-OK
        END-IF
    ELSE
        IF WS-NB-TROUVE = 0
            MOVE "N" TO WS-OK
        END-IF
    END-IF
    IF WS-OK = "O"
        DISPLAY "  PASS " WS-LIBELLE
    ELSE
        DISPLAY "  FAIL " WS-LIBELLE " (" WS-NB-TROUVE " trouve)"
        ADD 1 TO WS-NB-ECHECS
    END-IF
    MOVE 1 TO WS-ATT-TROUVE.

TEST-CSV.
    MOVE "C" TO WS-FORMAT
    MOVE 0 TO WS-ID MOVE 1 TO WS-CPT
    MOVE 20261001 TO WS-DEB MOVE 20261031 TO WS-FIN-P
    MOVE "00" TO WS-ATT-STATUS MOVE "O" TO WS-ATT-COH
    MOVE 5 TO WS-ATT-NB MOVE 500 TO WS-ATT-INIT MOVE 498 TO WS-ATT-FIN
    MOVE 132 TO WS-ATT-DEB MOVE 130 TO WS-ATT-CRED
    MOVE "csv compte 1, octobre : memes totaux" TO WS-LIBELLE
    PERFORM CAS-RELEVE
    MOVE "tests/RELEVE_0000000001_20261001_20261031.csv" TO WS-REL-NAME
    PERFORM CHARGER-TEXTE
    MOVE 1 TO WS-ATT-TROUVE
    MOVE "csv : titulaire" TO WS-LIBELLE
    MOVE "Titulaire;ALICE" TO WS-CHERCHE MOVE 15 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : en-tete des colonnes" TO WS-LIBELLE
    MOVE "date;heure;operation;compte_lie;debit"
        TO WS-CHERCHE MOVE 37 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : solde initial" TO WS-LIBELLE
    MOVE "Solde_initial;500.00" TO WS-CHERCHE MOVE 20 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : depot" TO WS-LIBELLE
    MOVE "2026-10-01;10:15;DEPOT;;;100.00;600.00" TO WS-CHERCHE
    MOVE 37 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : retrait" TO WS-LIBELLE
    MOVE "2026-10-05;10:15;RETRAIT;;50.00;;550.00" TO WS-CHERCHE
    MOVE 38 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : virement emis" TO WS-LIBELLE
    MOVE "VIREMENT EMIS;0000000002;80.00;;470.00" TO WS-CHERCHE
    MOVE 39 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : virement recu" TO WS-LIBELLE
    MOVE "VIREMENT RECU;0000000002;;30.00;500.00" TO WS-CHERCHE
    MOVE 39 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : frais" TO WS-LIBELLE
    MOVE "FRAIS DE TENUE;;2.00;;498.00" TO WS-CHERCHE MOVE 28 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : solde final" TO WS-LIBELLE
    MOVE "Solde_final;498.00" TO WS-CHERCHE MOVE 18 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : total debits" TO WS-LIBELLE
    MOVE "Total_debits;132.00" TO WS-CHERCHE MOVE 19 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : total credits" TO WS-LIBELLE
    MOVE "Total_credits;130.00" TO WS-CHERCHE MOVE 20 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : nombre d'operations" TO WS-LIBELLE
    MOVE "Operations;5" TO WS-CHERCHE MOVE 12 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : verification OK" TO WS-LIBELLE
    MOVE "Verification;OK" TO WS-CHERCHE MOVE 15 TO WS-LONG
    PERFORM COMPTER
    MOVE "csv : pas d'espace dans les montants" TO WS-LIBELLE
    MOVE "; " TO WS-CHERCHE MOVE 2 TO WS-LONG
    MOVE 0 TO WS-ATT-TROUVE
    PERFORM COMPTER

    *> compte 3 : historique rompu, relevé CSV incoherent (75)
    MOVE 3 TO WS-ID MOVE 3 TO WS-CPT
    MOVE "75" TO WS-ATT-STATUS
    MOVE 2 TO WS-ATT-NB MOVE 500 TO WS-ATT-INIT MOVE 500 TO WS-ATT-FIN
    MOVE 50 TO WS-ATT-DEB MOVE 100 TO WS-ATT-CRED MOVE "N" TO WS-ATT-COH
    MOVE "csv historique rompu (75)" TO WS-LIBELLE
    PERFORM CAS-RELEVE
    MOVE "tests/RELEVE_0000000003_20261001_20261031.csv" TO WS-REL-NAME
    PERFORM CHARGER-TEXTE
    MOVE "Verification;INCOHERENCE" TO WS-CHERCHE MOVE 24 TO WS-LONG
    MOVE 1 TO WS-ATT-TROUVE
    MOVE "csv : INCOHERENCE signalee" TO WS-LIBELLE
    PERFORM COMPTER

    *> format inconnu
    MOVE "X" TO WS-FORMAT
    MOVE 1 TO WS-ID MOVE 1 TO WS-CPT
    MOVE 9999999 TO WS-ATT-NB
    MOVE "76" TO WS-ATT-STATUS
    MOVE "format inconnu (76)" TO WS-LIBELLE
    PERFORM CAS-RELEVE
    MOVE "T" TO WS-FORMAT.

TEST-ERREURS.
    MOVE 9999999 TO WS-ATT-NB
    MOVE 20261001 TO WS-DEB MOVE 20261031 TO WS-FIN-P
    MOVE 2 TO WS-ID MOVE 1 TO WS-CPT
    MOVE "74" TO WS-ATT-STATUS
    MOVE "compte d'un autre client (74)" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE 1 TO WS-ID MOVE 99 TO WS-CPT
    MOVE "23" TO WS-ATT-STATUS
    MOVE "compte introuvable (23)" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE 1 TO WS-CPT
    MOVE 20261031 TO WS-DEB MOVE 20261001 TO WS-FIN-P
    MOVE "73" TO WS-ATT-STATUS
    MOVE "debut apres fin (73)" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE 20261301 TO WS-DEB MOVE 20261231 TO WS-FIN-P
    MOVE "date inexistante (73)" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE 3 TO WS-ID MOVE 3 TO WS-CPT
    MOVE 20261001 TO WS-DEB MOVE 20261031 TO WS-FIN-P
    MOVE "75" TO WS-ATT-STATUS
    MOVE 2 TO WS-ATT-NB MOVE 500 TO WS-ATT-INIT MOVE 500 TO WS-ATT-FIN
    MOVE 50 TO WS-ATT-DEB MOVE 100 TO WS-ATT-CRED MOVE "N" TO WS-ATT-COH
    MOVE "historique rompu (75)" TO WS-LIBELLE
    PERFORM CAS-RELEVE

    MOVE "tests/RELEVE_0000000003_20261001_20261031.txt" TO WS-REL-NAME
    PERFORM CHARGER-TEXTE
    MOVE "Verification : INCOHERENCE" TO WS-CHERCHE MOVE 26 TO WS-LONG
    MOVE 1 TO WS-ATT-TROUVE
    MOVE "fichier : INCOHERENCE signalee" TO WS-LIBELLE
    PERFORM COMPTER.

*> Vraies operations : 10 (1000.00) et 11 (50.00)
TEST-BOUT-EN-BOUT.
    DISPLAY "COMPTES_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/COMPTES_REL_E2E.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "TRX_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/TRX_REL_E2E.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "BATCH_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/BATCH_REL_E2E.dat" UPON ENVIRONMENT-VALUE
    DISPLAY "BATCH_REPORT_DIR" UPON ENVIRONMENT-NAME
    DISPLAY "tests" UPON ENVIRONMENT-VALUE
    DISPLAY "ALERTES_FILE" UPON ENVIRONMENT-NAME
    DISPLAY "tests/ALERTES_REL_E2E.dat" UPON ENVIRONMENT-VALUE

    INITIALIZE COMPTE-REC
    MOVE 10 TO CPT-NUM MOVE 1 TO CPT-ID-CLIENT MOVE 1000.00 TO CPT-SOLDE
    MOVE 5000 TO CPT-PLAFOND MOVE "A" TO CPT-STATUT
